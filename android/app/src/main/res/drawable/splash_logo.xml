<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A fixed canvas keeps the raster launcher logo near its native size. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/splash_icon_backdrop" />
        </shape>
    </item>
    <item android:width="44dp" android:height="44dp" android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="fill" />
    </item>
</layer-list>
